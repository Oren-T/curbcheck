root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,mjs,json,css,html,yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab

[web/vendor/**]
# Third-party files are byte-for-byte as shipped; see web/vendor/MANIFEST.md.
trim_trailing_whitespace = false
insert_final_newline = false
