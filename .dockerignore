# Keep the build context to what the Dockerfile actually copies: requirements,
# pyproject, CLAUDE.md, curbcheck/ and web/. Everything below either is a
# runtime artifact, is developer-only, or would be a needless 100+ MB of context.

data/
.git/
.github/
tests/
docs/
scripts/

*.sqlite
*.sqlite-journal
*.pmtiles

__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
build/
dist/
htmlcov/
.coverage

node_modules/
.env
.env.*

.devcontainer/
.vscode/
.idea/
.DS_Store

Dockerfile
docker-compose.yml
.dockerignore
Makefile
README.md
STYLE_GUIDE.md
environment.yml
# requirements-dev.txt stays in the context: the build stage installs the
# hashed hatchling from it (Dockerfile).
requirements-dev.in
requirements.in
eslint.config.js
.prettierrc
.prettierignore
.editorconfig
