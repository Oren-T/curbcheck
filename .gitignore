# Data lives on the mounted drive and is never committed
data/
*.sqlite
*.sqlite-journal
*.pmtiles

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
build/
dist/
htmlcov/
.coverage

# Node (frontend deps are vendored, not installed)
node_modules/

# Secrets and local config
.env
.env.*
!.env.example

# The static site's differential fixture is regenerated from the database on
# every run (docs/STATIC_SITE.md); the small committed fixtures live in
# site/tests/fixtures/.
site/tests/harness/expected.json

# Playwright MCP scratch output (snapshots, console logs)
.playwright-mcp/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
.hivemind/
